{
  "name": "Incident",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Short summary of the cybersecurity incident",
      "minLength": 3,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Firsthand account of what happened, in the reporter's words"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "default": "medium"
    },
    "category": {
      "type": "string",
      "enum": [
        "phishing",
        "malware",
        "ransomware",
        "data_breach",
        "unauthorized_access",
        "social_engineering",
        "ddos",
        "account_compromise",
        "insider_threat",
        "identity_theft",
        "online_fraud",
        "other"
      ],
      "title": "Category",
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "in_review",
        "escalated",
        "resolved",
        "closed"
      ],
      "title": "Status",
      "default": "reported"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "Where the incident occurred or was observed"
    },
    "incident_date": {
      "type": "string",
      "format": "date-time",
      "title": "Incident Date"
    },
    "ai_report": {
      "type": "string",
      "title": "AI Report",
      "description": "AI-generated professional report derived from the text description only"
    },
    "report_generated_date": {
      "type": "string",
      "format": "date-time",
      "title": "Report Generated Date"
    }
  },
  "required": [
    "title",
    "severity",
    "category",
    "status",
    "incident_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
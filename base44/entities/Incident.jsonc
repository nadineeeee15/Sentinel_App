{
  "name": "Incident",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Short summary of the incident",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Detailed account of what happened"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "default": "medium"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety",
        "security",
        "environmental",
        "equipment",
        "personnel",
        "other"
      ],
      "title": "Category",
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "title": "Status",
      "default": "open"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "Where the incident occurred"
    },
    "incident_date": {
      "type": "string",
      "format": "date-time",
      "title": "Incident Date"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "title": "Photo",
      "description": "Optional photo of the incident scene"
    }
  },
  "required": [
    "title",
    "severity",
    "category",
    "status",
    "incident_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
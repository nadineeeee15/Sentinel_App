{
  "name": "Incident",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Short summary of the incident",
      "minLength": 3,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Firsthand account of what happened, in the reporter's words"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "default": "medium"
    },
    "category": {
      "type": "string",
      "enum": [
        "stalking",
        "harassment",
        "cyberbullying",
        "threats",
        "domestic_abuse",
        "hate_speech",
        "image_based_abuse",
        "doxxing",
        "identity_theft",
        "online_fraud",
        "phishing",
        "other"
      ],
      "title": "Category",
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "title": "Status",
      "default": "draft"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "Where the incident occurred or was observed"
    },
    "incident_date": {
      "type": "string",
      "format": "date-time",
      "title": "Incident Date"
    },
    "report_number": {
      "type": "string",
      "title": "Report Number",
      "description": "Unique reference number assigned when the AI report is generated"
    },
    "ai_report": {
      "type": "string",
      "title": "AI Report",
      "description": "AI-generated professional report derived from the text description only"
    },
    "report_generated_date": {
      "type": "string",
      "format": "date-time",
      "title": "Report Generated Date"
    }
  },
  "required": [
    "title",
    "severity",
    "category",
    "status",
    "incident_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}